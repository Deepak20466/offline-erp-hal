# Copy this file to `.env` and adjust as needed. All values shown are the
# application's built-in defaults — you only need to set what you want to
# change. `.env` itself is gitignored, so real secrets never get committed.

APP_NAME="Offline ERP HAL"

# SQLite by default (fully offline). Point this at a Postgres/Supabase URL
# instead for a hosted deployment (postgres:// and postgresql:// both work).
DATABASE_URL=sqlite:///data/hal_erp.db

# REQUIRED for any real deployment: signs session cookies and CSRF tokens.
# The app logs a startup warning if this default placeholder is still in use.
SECRET_KEY=hal-erp-offline-secret-key-change-in-production-9f8e7d6c5b4a

# Password seeded for the default admin account (admin@hal.internal) the first
# time a deployment starts with an empty database. Recommended for any real
# deployment: this repo's default value is publicly documented in README.md, so
# every untouched clone starts with the same one. Only affects the initial seed --
# changing this after the admin account already exists does not change its
# password (change it via the app's own login/profile screens instead).
DEFAULT_ADMIN_PASSWORD=Admin@123

SESSION_COOKIE_NAME=hal_erp_session
REMEMBER_ME_DAYS=30
SESSION_HOURS=12
PAGE_SIZE=50
COMPANY_NAME="Hindustan Aeronautics Limited"
GST_DEFAULT_PERCENTAGE=18.0

# Base folder for permanently saved Excel/Word documents (View -> Excel/Word).
# Leave unset for local/offline use (defaults to data/contract_files next to
# the app). If deploying to Render, this MUST point at a mounted Persistent
# Disk path, or saved documents will be lost on every redeploy/restart.
DOCUMENT_STORAGE_DIR=

# Desktop app only -- ignored by the website (main.py never reads this). Leave
# unset to keep the desktop app's original fully-offline behavior (it spawns its
# own local server + SQLite database). Set to a hosted backend's URL (e.g. a
# Render deployment) to make the desktop app a thin client of that backend
# instead, sharing its Postgres database with the website. See README.md's
# "Connecting the desktop app to a hosted backend" section.
DESKTOP_BACKEND_URL=
